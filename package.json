{
  "name": "voidlauncher",
  "version": "1.5.3",
  "description": "Minecraft Java launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.void.launcher",
    "productName": "VoidLauncher",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "src/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VoidLauncher",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "language": "1049",
      "deleteAppDataOnUninstall": false,
      "artifactName": "VoidLauncher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "VoidLauncher-Portable-${version}.${ext}"
    },
    "copyright": "Copyright © 2026 VoidLauncher",
    "publish": [
      {
        "provider": "github",
        "owner": "pidorchain",
        "repo": "VoidLauncher"
      }
    ]
  },
  "author": "VoidLauncher"
}
